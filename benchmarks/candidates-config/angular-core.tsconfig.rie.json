{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@angular/*": ["./*"]
    }
  },
  "include": ["core/src/**/*.ts", "core/primitives/**/*.ts", "core/index.ts", "core/public_api.ts"],
  "exclude": ["**/test/**", "**/testing/**", "**/*_spec.ts", "**/*.spec.ts", "**/*.d.ts", "core/schematics/**"]
}
