{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["ESNext", "DOM", "WebWorker", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "strictNullChecks": false,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "~/*": ["./src/*"],
      "pixi.js": ["./src/index.ts"],
      "pixi.js/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/__tests__/**", "**/*.test.ts", "**/*.d.ts"]
}
