{
  "name": "rie-check",
  "version": "0.1.0",
  "description": "Fail a pull request that makes TypeScript runtime import cycles worse than its base branch, with the import line behind every loop. Also an MCP server that gives coding agents the import graph.",
  "keywords": [
    "typescript",
    "circular-dependencies",
    "import-cycles",
    "github-action",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arjade25/repo-intelligence-engine.git"
  },
  "bin": {
    "rie-check": "./dist/check/cli.js",
    "rie": "./dist/cli.js",
    "rie-mcp": "./dist/mcp-server/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').mkdirSync('dist/storage',{recursive:true});require('fs').copyFileSync('src/storage/schema.sql','dist/storage/schema.sql')\"",
    "prepublishOnly": "npm run build",
    "index": "tsx src/indexer/cli.ts",
    "mcp": "tsx src/mcp-server/index.ts",
    "check": "tsx src/check/cli.ts",
    "bench": "tsx benchmarks/run.ts",
    "oracle": "tsx benchmarks/oracle/compare.ts",
    "screen": "tsx benchmarks/oracle/screen.ts",
    "replay": "tsx benchmarks/replay/cli.ts",
    "demo": "tsx benchmarks/demo/cli.ts",
    "agent-eval": "tsx benchmarks/agent-eval/cli.ts",
    "taskgen": "tsx benchmarks/taskgen/cli.ts",
    "harness": "tsx benchmarks/harness/cli.ts",
    "regrade": "tsx benchmarks/harness/regrade.ts",
    "audit": "tsx benchmarks/harness/audit.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.4.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "madge": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^4.1.10"
  }
}
